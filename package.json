{
  "name": "talking-avatar",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "lint": "biome check .",
    "typecheck": "pnpm -r --if-present run typecheck && tsc -p tsconfig.json --noEmit && pnpm -r --if-present run build",
    "test": "vitest run && pnpm -r --if-present run test",
    "build": "pnpm -r --if-present run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
